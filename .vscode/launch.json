{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Train single",
            "type": "debugpy",
            "request": "launch",
            "program": "/home/ubuntu/playground_jean/DiffDec/train_single.py",
            "console": "integratedTerminal",
            "args": [
                "--config=configs/single.yml",
            ]
        },
        {
            "name": "Generate given pocket",
            "type": "debugpy",
            "request": "launch",
            "program": "/home/ubuntu/playground_jean/DiffDec/sample_single_for_specific_context.py",
            "console": "integratedTerminal",
            "args": [
                "--scaffold_smiles_file=./data/examples/scaf.smi",
                "--protein_file=./data/examples/protein.pdb",
                "--scaffold_file=./data/examples/scaf.sdf",
                "--task_name=exp",
                "--data_dir=./data/examples",
                "--checkpoint=./ckpt/diffdec_single.ckpt",
                "--samples_dir=samples_exp",
                "--n_samples=1",
                "--device=cuda:0"
            ]
        },
    ]
}